ss() {
    if [[ $# -eq 0 ]]; then
        print "usage: ss <index|ls|cp <dest>>" >&2
        return 1
    fi

    case "$1" in
        ls)
            screenshot clipboard list
            ;;
        cp)
            shift
            if [[ $# -eq 0 ]]; then
                print "usage: ss cp <dest>" >&2
                return 1
            fi
            local display_source_shell
            local display_source
            local source_path
            display_source="$(screenshot clipboard copy --index 1)" || return
            display_source_shell="${display_source// /\\ }"
            print "copying $display_source_shell -> $*"
            source_path="$display_source"
            source_path="${(Q)source_path}"
            source_path="${source_path/#\~/$HOME}"
            cp "$source_path" "$@"
            ;;
        <->)
            screenshot clipboard copy --index "$1"
            ;;
        *)
            print "usage: ss <index|ls|cp <dest>>" >&2
            return 1
            ;;
    esac
}

hunk() {
    emulate -L zsh
    setopt pipefail

    local hunk_bin="${HUNK_COMMAND_PATH:-hunk}"

    if (( $# > 0 )); then
        command "$hunk_bin" "$@"
        return
    fi

    local repo_root
    repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
        print -u2 "hunk: current directory is not inside a Git repository"
        return 1
    }

    cd "$repo_root" || return

    local status_output
    status_output=$(git status --porcelain --untracked-files=normal) || {
        print -u2 "hunk: unable to read the working tree status"
        return 1
    }

    if [[ -n "$status_output" ]]; then
        HUNK_REVIEW_TARGET=working command "$hunk_bin" diff --mode stack --fast
        return
    fi

    if ! git rev-parse --verify --quiet 'main^{commit}' >/dev/null; then
        print -u2 "hunk: working tree is clean and branch 'main' does not exist"
        return 1
    fi

    git diff --quiet main...HEAD --
    local comparison_status=$?
    if (( comparison_status == 0 )); then
        print "hunk: no changes since HEAD or since branching from main"
        return
    fi

    if (( comparison_status != 1 )); then
        print -u2 "hunk: unable to compare the current branch with main"
        return "$comparison_status"
    fi

    HUNK_REVIEW_TARGET=main command "$hunk_bin" diff main... --mode stack --fast
}

vm-tab() {
    emulate -L zsh
    setopt pipefail

    if [[ $# -ne 0 ]]; then
        print "usage: vm-tab" >&2
        return 1
    fi

    if (( !$+commands[fzf] )); then
        print "fzf is required" >&2
        return 1
    fi

    if (( !$+commands[osascript] )); then
        print "osascript is required" >&2
        return 1
    fi

    if [[ ! -x /opt/homebrew/bin/autossh ]]; then
        print "/opt/homebrew/bin/autossh is required" >&2
        return 1
    fi

    local session
    session="$(ssh vm '/home/linuxbrew/.linuxbrew/bin/tmux list-sessions -F "#S"' | fzf)" || {
        print "failed to select tmux session" >&2
        return 1
    }

    if [[ -z "$session" ]]; then
        print "selected tmux session is empty" >&2
        return 1
    fi

    local remote_session
    remote_session=${(q)session}

    ssh vm "exec /home/linuxbrew/.linuxbrew/bin/tmux has-session -t $remote_session" || {
        print "tmux session no longer exists: $session" >&2
        return 1
    }

    osascript - "$session" <<'EOF' || {
on run argv
    set sessionName to item 1 of argv
    tell application "Ghostty"
        tell front window
            perform action ("set_tab_title:" & sessionName) on focused terminal of selected tab
        end tell
    end tell
end run
EOF
        print "failed to rename current Ghostty tab" >&2
        return 1
    }

    env AUTOSSH_POLL=30 AUTOSSH_GATETIME=0 \
        /opt/homebrew/bin/autossh -M 0 -o ClearAllForwardings=yes \
        vm "exec /home/linuxbrew/.linuxbrew/bin/tmux attach-session -d -t $remote_session"
}

# Fuzzy find and open file in Neovim
fz() {
    local file visible_files hidden_files
    visible_files='fd --type f --strip-cwd-prefix --exclude .git'
    hidden_files="$visible_files --hidden"

    file=$(eval "$visible_files" | fzf \
        --prompt='Files> ' \
        --footer='Enter Open | Esc Close | Ctrl+/ Hidden: Off' \
        --footer-border=line \
        --bind="ctrl-/:transform:
            if [[ \$FZF_PROMPT == 'Files> ' ]]; then
                echo 'reload($hidden_files)+change-prompt(All files> )+change-footer(Enter Open | Esc Close | Ctrl+/ Hidden: On)'
            else
                echo 'reload($visible_files)+change-prompt(Files> )+change-footer(Enter Open | Esc Close | Ctrl+/ Hidden: Off)'
            fi") || return
    if [[ -n "$file" ]]; then
        ${EDITOR:-nvim} -- "$file"
    fi
}
