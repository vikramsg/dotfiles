# Show usage reported by the OpenCode V2 service, without reading its database.
ocost() {
    emulate -L zsh
    setopt pipefail
    local LC_ALL=C

    local days='' output=table window='all time'
    while (( $# )); do
        case "$1" in
            --days)
                if (( $# < 2 )) || [[ -n "$days" || "$2" != <-> || ${#2} -gt 6 ]]; then
                    print -u2 'usage: ocost [--days N] [--json] (N: 0 for today, or a positive integer up to 999999)'
                    return 1
                fi
                days="$2"
                shift 2
                ;;
            --json)
                output=json
                shift
                ;;
            --help)
                print 'usage: ocost [--days N] [--json|--help]'
                print 'Show project costs, per-project models, steps, and token/cache usage.'
                print 'Omit --days for all time; --days 0 means today (local midnight).'
                print -r -- '--days N means the last N rolling 24-hour periods.'
                print -r -- '--json includes overall API statistics and every project response.'
                return
                ;;
            *)
                print -u2 'usage: ocost [--days N] [--json|--help]'
                return 1
                ;;
        esac
    done

    local dependency
    for dependency in opencode2 jq; do
        if (( !$+commands[$dependency] )); then
            print -u2 "ocost: $dependency is required"
            return 1
        fi
    done

    # Use one time range for every request, rather than a moving "now" per project.
    zmodload zsh/datetime || return
    local end_ms start_ms=0 today midnight
    printf -v end_ms '%.0f' $(( EPOCHREALTIME * 1000 ))
    if [[ -n "$days" ]]; then
        days=$(( 10#$days ))
        if (( days == 0 )); then
            strftime -s today '%Y-%m-%d' "$EPOCHSECONDS"
            midnight=$(strftime -r '%Y-%m-%d %H:%M:%S' "$today 00:00:00") || return
            start_ms=$(( midnight * 1000 ))
            window='today (local midnight)'
        else
            start_ms=$(( end_ms - days * 86400000 ))
            (( start_ms < 0 )) && start_ms=0
            window="last $days days (rolling 24 hours)"
        fi
    fi

    local endpoint="/api/session/stats?from=$start_ms&to=$end_ms"
    local response projects project encoded_id usage report entries='[]'
    response=$(_ocost_stats "$endpoint") || return
    projects=$(command opencode2 api get /api/project) || {
        print -u2 'ocost: unable to fetch OpenCode V2 projects'
        return 1
    }
    if ! print -r -- "$projects" | command jq -e -s '
        length == 1 and (.[0] | type == "array" and
            all((.id | type == "string" and length > 0) and (.canonical | type == "string")) and
            (length == (unique_by(.id) | length)))
    ' >/dev/null 2>&1; then
        print -u2 'ocost: invalid OpenCode V2 projects response'
        return 1
    fi

    # Fetch everything before rendering: a failed project request is not zero usage.
    local project_rows
    project_rows=$(print -r -- "$projects" | command jq -c '.[]') || return
    if [[ -n "$project_rows" ]]; then
        for project in "${(@f)project_rows}"; do
            encoded_id=$(print -r -- "$project" | command jq -r '.id | @uri') || return
            usage=$(_ocost_stats "$endpoint&project=$encoded_id") || return
            entries=$(print -r -- "$entries" | command jq --argjson project "$project" --argjson usage "$usage" '
                . + [{project: $project, usage: $usage}]
            ') || return
        done
    fi
    report=$(print -r -- "$response" | command jq --argjson projects "$entries" '
        . + {projects: ($projects | sort_by(-.usage.data.cost, .project.canonical, .project.id))}
    ') || return

    if [[ "$output" == json ]]; then
        print -r -- "$report"
        return
    fi

    print 'OpenCode V2 usage'
    print 'Source: OpenCode service API statistics'
    print -r -- "Window: $window"
    print
    _ocost_totals "$response" || return
    print '\nBy project'
    local cost roots children steps directory project_id
    print -r -- "$report" | command jq -r '.projects[] |
        select(.usage.data | .sessions > 0 or .subagents > 0 or .steps > 0 or .cost != 0) |
        [.usage.data.cost, .usage.data.sessions, .usage.data.subagents, .usage.data.steps,
         .project.canonical, .project.id[0:8]] | @tsv
    ' | while IFS=$'\t' read -r cost roots children steps directory project_id; do
        printf '%s [%s]\n  Cost: $%.6f  Roots: %s  Subs: %s  Steps: %s\n' \
            "$directory" "$project_id" "$cost" "$roots" "$children" "$steps"
    done || return

    local project_usage label provider model variant input output_tokens reasoning cache_read cache_write
    project_rows=$(print -r -- "$report" | command jq -c '.projects[] |
        select(.usage.data | .sessions > 0 or .subagents > 0 or .steps > 0 or .cost != 0)
    ') || return
    if [[ -z "$project_rows" ]]; then
        print 'No project usage in this window.'
    else
        for project in "${(@f)project_rows}"; do
            label=$(print -r -- "$project" | command jq -r '
                [.project.canonical + " [" + .project.id[0:8] + "]"] | @tsv
            ') || return
            project_usage=$(print -r -- "$project" | command jq '.usage') || return
            printf '\nProject: %s\n' "$label"
            _ocost_totals "$project_usage" || return
            printf '\n%-10s %-24s %-10s %14s %7s\n' 'Provider' 'Model' 'Variant' 'Cost (USD)' 'Steps'
            print -r -- "$project_usage" | command jq -r '.data.models | sort_by(-.cost)[] |
                [.model.providerID, .model.id, (.model.variant // "default"), .cost, .steps,
                 .tokens.input, .tokens.output, .tokens.reasoning, .tokens.cache.read, .tokens.cache.write] | @tsv
            ' | while IFS=$'\t' read -r provider model variant cost steps input output_tokens reasoning cache_read cache_write; do
                printf '%-10s %-24s %-10s %14.6f %7s\n' "$provider" "$model" "$variant" "$cost" "$steps"
                printf '  Input: %s  Output: %s  Reasoning: %s\n' "$input" "$output_tokens" "$reasoning"
                printf '  Cache read: %s  Cache write: %s\n' "$cache_read" "$cache_write"
            done || return
        done
    fi

    if print -r -- "$report" | command jq -e '
        (([.projects[].usage.data.cost] | add // 0) - .data.cost | fabs) > 0.000001
    ' >/dev/null; then
        print '\nNote: project costs do not reconcile to the overall total.'
        print 'The API requests are separate reads, not an atomic snapshot.'
    fi
    return 0
}

# Keep the API contract in one place for overall and project statistics.
_ocost_stats() {
    emulate -L zsh
    setopt pipefail
    local response
    response=$(command opencode2 api get "$1") || {
        print -u2 "ocost: unable to fetch OpenCode V2 usage statistics ($1)"
        return 1
    }

    # Validate before printing so API errors cannot masquerade as zero usage.
    if ! print -r -- "$response" | command jq -e -s '
        def tokens: type == "object" and
            ([.input, .output, .reasoning, .cache.read, .cache.write] | all(type == "number"));
        length == 1 and (.[0].data |
            type == "object" and
            ([.cost, .sessions, .subagents, .prompts, .steps] | all(type == "number")) and
            (.tokens | tokens) and
            (.models | type == "array" and all(
                ([.cost, .steps] | all(type == "number")) and
                (.tokens | tokens) and
                ([.model.providerID, .model.id] | all(type == "string")) and
                (.model.variant | . == null or type == "string")
            ))
        )
    ' >/dev/null 2>&1; then
        print -u2 "ocost: invalid OpenCode V2 statistics response ($1)"
        return 1
    fi
    print -r -- "$response"
}

# Reuse the same cost/count/token presentation for the overall and project totals.
_ocost_totals() {
    emulate -L zsh
    setopt pipefail
    local LC_ALL=C
    local label value
    print -r -- "$1" | command jq -r '.data |
        ["Total cost", .cost], ["Root sessions", .sessions],
        ["Subagents", .subagents], ["Prompts", .prompts],
        ["Assistant steps", .steps], ["Input tokens", .tokens.input],
        ["Output tokens", .tokens.output], ["Reasoning tokens", .tokens.reasoning],
        ["Cache read", .tokens.cache.read], ["Cache write", .tokens.cache.write] | @tsv
    ' | while IFS=$'\t' read -r label value; do
        if [[ "$label" == 'Total cost' ]]; then
            printf '%-18s $%.6f\n' "$label" "$value"
        else
            printf '%-18s %s\n' "$label" "$value"
        fi
    done
}

ss() {
    if [[ $# -eq 0 ]]; then
        print "usage: ss <index|ls|cp <dest>>" >&2
        return 1
    fi

    case "$1" in
        ls)
            screenshot clipboard list
            ;;
        cp)
            shift
            if [[ $# -eq 0 ]]; then
                print "usage: ss cp <dest>" >&2
                return 1
            fi
            local display_source_shell
            local display_source
            local source_path
            display_source="$(screenshot clipboard copy --index 1)" || return
            display_source_shell="${display_source// /\\ }"
            print "copying $display_source_shell -> $*"
            source_path="$display_source"
            source_path="${(Q)source_path}"
            source_path="${source_path/#\~/$HOME}"
            cp "$source_path" "$@"
            ;;
        <->)
            screenshot clipboard copy --index "$1"
            ;;
        *)
            print "usage: ss <index|ls|cp <dest>>" >&2
            return 1
            ;;
    esac
}

hunk() {
    emulate -L zsh
    setopt pipefail

    if (( $# > 0 )); then
        command hunk "$@"
        return
    fi

    local repo_root
    repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
        print -u2 "hunk: current directory is not inside a Git repository"
        return 1
    }

    cd "$repo_root" || return

    local status_output
    status_output=$(git status --porcelain --untracked-files=normal) || {
        print -u2 "hunk: unable to read the working tree status"
        return 1
    }

    if [[ -n "$status_output" ]]; then
        HUNK_REVIEW_TARGET=working command hunk diff --mode stack
        return
    fi

    if ! git rev-parse --verify --quiet 'main^{commit}' >/dev/null; then
        print -u2 "hunk: working tree is clean and branch 'main' does not exist"
        return 1
    fi

    git diff --quiet main...HEAD --
    local comparison_status=$?
    if (( comparison_status == 0 )); then
        print "hunk: no changes since HEAD or since branching from main"
        return
    fi

    if (( comparison_status != 1 )); then
        print -u2 "hunk: unable to compare the current branch with main"
        return "$comparison_status"
    fi

    HUNK_REVIEW_TARGET=main command hunk diff main... --mode stack
}

vm-tab() {
    emulate -L zsh
    setopt pipefail

    if [[ $# -ne 0 ]]; then
        print "usage: vm-tab" >&2
        return 1
    fi

    if (( !$+commands[fzf] )); then
        print "fzf is required" >&2
        return 1
    fi

    if (( !$+commands[osascript] )); then
        print "osascript is required" >&2
        return 1
    fi

    if [[ ! -x /opt/homebrew/bin/autossh ]]; then
        print "/opt/homebrew/bin/autossh is required" >&2
        return 1
    fi

    local session
    session="$(ssh vm '/home/linuxbrew/.linuxbrew/bin/tmux list-sessions -F "#S"' | fzf)" || {
        print "failed to select tmux session" >&2
        return 1
    }

    if [[ -z "$session" ]]; then
        print "selected tmux session is empty" >&2
        return 1
    fi

    local remote_session
    remote_session=${(q)session}

    ssh vm "exec /home/linuxbrew/.linuxbrew/bin/tmux has-session -t $remote_session" || {
        print "tmux session no longer exists: $session" >&2
        return 1
    }

    osascript - "$session" <<'EOF' || {
on run argv
    set sessionName to item 1 of argv
    tell application "Ghostty"
        tell front window
            perform action ("set_tab_title:" & sessionName) on focused terminal of selected tab
        end tell
    end tell
end run
EOF
        print "failed to rename current Ghostty tab" >&2
        return 1
    }

    env AUTOSSH_POLL=30 AUTOSSH_GATETIME=0 \
        /opt/homebrew/bin/autossh -M 0 -o ClearAllForwardings=yes \
        vm "exec /home/linuxbrew/.linuxbrew/bin/tmux attach-session -d -t $remote_session"
}

# Fuzzy find and open file in Neovim
fz() {
    local file visible_files hidden_files
    visible_files='fd --type f --strip-cwd-prefix --exclude .git'
    hidden_files="$visible_files --hidden"

    file=$(eval "$visible_files" | fzf \
        --prompt='Files> ' \
        --footer='Enter Open | Esc Close | Ctrl+/ Hidden: Off' \
        --footer-border=line \
        --bind="ctrl-/:transform:
            if [[ \$FZF_PROMPT == 'Files> ' ]]; then
                echo 'reload($hidden_files)+change-prompt(All files> )+change-footer(Enter Open | Esc Close | Ctrl+/ Hidden: On)'
            else
                echo 'reload($visible_files)+change-prompt(Files> )+change-footer(Enter Open | Esc Close | Ctrl+/ Hidden: Off)'
            fi") || return
    if [[ -n "$file" ]]; then
        ${EDITOR:-nvim} -- "$file"
    fi
}
