{
  "server": {
    "host": "127.0.0.1",
    "port": 17421
  },
  "appearance": {
    "theme": "tokyo-night"
  },
  "applications": {
    "ghostty": {
      "bundle_id": "com.mitchellh.ghostty"
    },
    "zed": {
      "bundle_id": "dev.zed.Zed"
    }
  },
  "layouts": {
    "ghostty_full": {
      "type": "maximize",
      "applications": ["ghostty"],
      "focus": "ghostty"
    },
    "zed_full": {
      "type": "maximize",
      "applications": ["zed"],
      "focus": "zed"
    },
    "ghostty_zed": {
      "type": "columns",
      "applications": ["ghostty", "zed"],
      "ratios": [0.5, 0.5],
      "target_screen_application": "ghostty",
      "focus": "ghostty",
      "gap": 8
    },
    "zed_ghostty": {
      "type": "columns",
      "applications": ["zed", "ghostty"],
      "ratios": [0.5, 0.5],
      "target_screen_application": "ghostty",
      "focus": "zed",
      "gap": 8
    }
  },
  "hotkeys": [
    {
      "modifiers": ["cmd", "shift"],
      "key": "1",
      "scope": "global",
      "action": { "type": "apply_layout", "layout": "ghostty_full" }
    },
    {
      "modifiers": ["cmd", "shift"],
      "key": "2",
      "scope": "global",
      "action": { "type": "apply_layout", "layout": "zed_full" }
    },
    {
      "modifiers": ["cmd", "shift"],
      "key": "3",
      "scope": "global",
      "action": { "type": "apply_layout", "layout": "ghostty_zed" }
    },
    {
      "modifiers": ["cmd", "shift"],
      "key": "4",
      "scope": "global",
      "action": { "type": "apply_layout", "layout": "zed_ghostty" }
    }
  ],
  "screenshots": {
    "directory": "/Users/Shared/Screenshots",
    "extensions": ["png", "jpg", "jpeg", "webp"],
    "debounce_seconds": 0.2,
    "capture_settle_seconds": 0.15,
    "preview": {
      "width": 360,
      "max_height": 260,
      "margin": 24,
      "timeout_seconds": 8,
      "corner_radius": 12
    }
  }
}
