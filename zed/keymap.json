[
  {
    "bindings": {
      "cmd-alt-shift-up": "multi_workspace::MoveProjectUp",
      "cmd-alt-shift-down": "multi_workspace::MoveProjectDown",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-cmd-left": "workspace::ActivatePaneLeft",
      "ctrl-cmd-right": "workspace::ActivatePaneRight",
      "ctrl-cmd-up": "workspace::ActivatePaneUp",
      "ctrl-cmd-down": "workspace::ActivatePaneDown",
      "cmd-shift-a": "multi_workspace::ToggleWorkspaceSidebar",
      "cmd-shift-e": "editor::ToggleFocus",
      "cmd-shift-g": "git_panel::ToggleFocus",
      "cmd-shift-j": "agent::Toggle",
      "cmd-shift-x": "project_panel::ToggleFocus",
      "ctrl-cmd-tab": "agents_sidebar::ToggleThreadSwitcher",
      "cmd-g b": "git::Switch",
      "cmd-g p": "git::CreatePullRequest",
      "cmd-g down": "git::Pull",
      "cmd-g up": "git::Push",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-cmd-left": "workspace::ActivatePaneLeft",
      "ctrl-cmd-right": "workspace::ActivatePaneRight",
      "ctrl-cmd-up": "workspace::ActivatePaneUp",
      "ctrl-cmd-down": "workspace::ActivatePaneDown",
      "cmd-shift-g": "git_panel::ToggleFocus",
      "cmd-shift-j": "agent::Toggle",
      "cmd-shift-x": "pane::RevealInProjectPanel",
      "ctrl-cmd-tab": "agents_sidebar::ToggleThreadSwitcher",
      "cmd-g b": "git::Switch",
      "cmd-g p": "git::CreatePullRequest",
      "cmd-g down": "git::Pull",
      "cmd-g up": "git::Push",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      // Avoid Shift+Enter becoming Ctrl+J, which vim-tmux-navigator intercepts; OpenCode treats Alt+Enter as a newline.
      "shift-enter": ["terminal::SendText", "\u001b\r"],
      "ctrl-cmd-left": "workspace::ActivatePaneLeft",
      "ctrl-cmd-right": "workspace::ActivatePaneRight",
      "ctrl-cmd-up": "workspace::ActivatePaneUp",
      "ctrl-cmd-down": "workspace::ActivatePaneDown",
      "cmd-shift-e": "editor::ToggleFocus",
      "cmd-shift-g": "git_panel::ToggleFocus",
      "cmd-shift-x": "project_panel::ToggleFocus",
      "ctrl-cmd-tab": "agents_sidebar::ToggleThreadSwitcher",
      "cmd-g b": "git::Switch",
      "cmd-g p": "git::CreatePullRequest",
      "cmd-g down": "git::Pull",
      "cmd-g up": "git::Push",
    },
  },
  {
    "context": "AgentPanel",
    "bindings": {
      "ctrl-cmd-left": "workspace::ActivatePaneLeft",
      "ctrl-cmd-right": "workspace::ActivatePaneRight",
      "ctrl-cmd-up": "workspace::ActivatePaneUp",
      "ctrl-cmd-down": "workspace::ActivatePaneDown",
      "cmd-shift-e": "editor::ToggleFocus",
      "cmd-shift-g": "git_panel::ToggleFocus",
      "cmd-shift-j": "agent::Toggle",
      "cmd-shift-x": "project_panel::ToggleFocus",
      "ctrl-cmd-tab": "agents_sidebar::ToggleThreadSwitcher",
      "cmd-g b": "git::Switch",
      "cmd-g p": "git::CreatePullRequest",
      "cmd-g down": "git::Pull",
      "cmd-g up": "git::Push",
    },
  },
  {
    "context": "AgentPanel > Terminal",
    "bindings": {
      // NOTE: Vertical navigation goes to tmux; horizontal navigation stays in Zed.
      // This only works if we only split in tmux in one direction
      "ctrl-cmd-left": "workspace::ActivatePaneLeft",
      "ctrl-cmd-down": ["terminal::SendKeystroke", "ctrl-j"],
      "ctrl-cmd-up": ["terminal::SendKeystroke", "ctrl-k"],
      "ctrl-cmd-right": "workspace::ActivatePaneRight",
      "cmd-shift-e": "editor::ToggleFocus",
      "cmd-shift-g": "git_panel::ToggleFocus",
      "cmd-shift-j": "agent::Toggle",
      "cmd-shift-x": "project_panel::ToggleFocus",
      "ctrl-cmd-tab": "agents_sidebar::ToggleThreadSwitcher",
      "cmd-g b": "git::Switch",
      "cmd-g p": "git::CreatePullRequest",
      "cmd-g down": "git::Pull",
      "cmd-g up": "git::Push",
    },
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      // Note: Without the sequence we would completely lose focus and had to use the mouse
      "cmd-shift-x": [
        "action::Sequence",
        ["workspace::CloseActiveDock", "workspace::FocusCenterPane"],
      ],
    },
  },
  {
    "context": "GitPanel",
    "bindings": {
      // Zed defaults: cmd-y stages the selected file here, and stages the current hunk + moves next in diff editors.
      // Zed defaults: cmd-shift-y unstages the selected file here, and unstages the current hunk + moves next in diff editors.
      "cmd-shift-g": "git_panel::ToggleFocus",
      "ctrl-cmd-tab": "agents_sidebar::ToggleThreadSwitcher",
      "cmd-g b": "git::Switch",
      "cmd-g p": "git::CreatePullRequest",
      "cmd-g down": "git::Pull",
      "cmd-g up": "git::Push",
    },
  },
  {
    "context": "GitDiff > Editor && VimControl",
    "bindings": {
      "g s": "git::StageAndNext",
      "g u": "git::UnstageAndNext",
      "g r": "git::RestoreAndNext",
      "ctrl-cmd-right": "git_panel::ToggleFocus",
    },
  },
]
