[
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-cmd-left": "workspace::ActivatePaneLeft",
      "ctrl-cmd-right": "workspace::ActivatePaneRight",
      "ctrl-cmd-up": "workspace::ActivatePaneUp",
      "ctrl-cmd-down": "workspace::ActivatePaneDown",
      "cmd-shift-a": "multi_workspace::ToggleWorkspaceSidebar",
      "cmd-shift-e": "editor::ToggleFocus",
      "cmd-shift-g": "git_panel::ToggleFocus",
      "cmd-shift-j": "agent::Toggle",
      "cmd-shift-x": "project_panel::ToggleFocus",
      "cmd-g b": "git::Switch",
      "cmd-g p": "git::CreatePullRequest",
      "cmd-g up": "git::Push",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-cmd-left": "workspace::ActivatePaneLeft",
      "ctrl-cmd-right": "workspace::ActivatePaneRight",
      "ctrl-cmd-up": "workspace::ActivatePaneUp",
      "ctrl-cmd-down": "workspace::ActivatePaneDown",
      "cmd-shift-g": "git_panel::ToggleFocus",
      "cmd-shift-j": "agent::Toggle",
      "cmd-shift-x": "pane::RevealInProjectPanel",
      "cmd-g b": "git::Switch",
      "cmd-g p": "git::CreatePullRequest",
      "cmd-g up": "git::Push",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-cmd-left": "workspace::ActivatePaneLeft",
      "ctrl-cmd-right": "workspace::ActivatePaneRight",
      "ctrl-cmd-up": "workspace::ActivatePaneUp",
      "ctrl-cmd-down": "workspace::ActivatePaneDown",
      "cmd-shift-e": "editor::ToggleFocus",
      "cmd-shift-g": "git_panel::ToggleFocus",
      "cmd-shift-x": "project_panel::ToggleFocus",
      "cmd-g b": "git::Switch",
      "cmd-g p": "git::CreatePullRequest",
      "cmd-g up": "git::Push",
    },
  },
  {
    "context": "AgentPanel",
    "bindings": {
      "ctrl-cmd-left": "workspace::ActivatePaneLeft",
      "ctrl-cmd-right": "workspace::ActivatePaneRight",
      "ctrl-cmd-up": "workspace::ActivatePaneUp",
      "ctrl-cmd-down": "workspace::ActivatePaneDown",
      "cmd-shift-e": "editor::ToggleFocus",
      "cmd-shift-g": "git_panel::ToggleFocus",
      "cmd-shift-j": "agent::Toggle",
      "cmd-shift-x": "project_panel::ToggleFocus",
      "cmd-g b": "git::Switch",
      "cmd-g p": "git::CreatePullRequest",
      "cmd-g up": "git::Push",
    },
  },
  {
    "context": "AgentPanel > Terminal",
    "bindings": {
      // NOTE: To make navigation inside tmux be like zed navigation
      "ctrl-cmd-left": ["terminal::SendKeystroke", "ctrl-h"],
      "ctrl-cmd-down": ["terminal::SendKeystroke", "ctrl-j"],
      "ctrl-cmd-up": ["terminal::SendKeystroke", "ctrl-k"],
      "ctrl-cmd-right": ["terminal::SendKeystroke", "ctrl-l"],
      "cmd-shift-e": "editor::ToggleFocus",
      "cmd-shift-g": "git_panel::ToggleFocus",
      "cmd-shift-j": "agent::Toggle",
      "cmd-shift-x": "project_panel::ToggleFocus",
      "cmd-g b": "git::Switch",
      "cmd-g p": "git::CreatePullRequest",
      "cmd-g up": "git::Push",
    },
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      // Note: Without the sequence we would completely lose focus and had to use the mouse
      "cmd-shift-x": [
        "action::Sequence",
        ["workspace::CloseActiveDock", "workspace::FocusCenterPane"],
      ],
    },
  },
  {
    "context": "GitPanel",
    "bindings": {
      // Zed defaults: cmd-y stages the selected file here, and stages the current hunk + moves next in diff editors.
      // Zed defaults: cmd-shift-y unstages the selected file here, and unstages the current hunk + moves next in diff editors.
      "cmd-shift-g": "git_panel::ToggleFocus",
      "cmd-g b": "git::Switch",
      "cmd-g p": "git::CreatePullRequest",
      "cmd-g up": "git::Push",
    },
  },
  {
    "context": "GitDiff > Editor && VimControl",
    // Zed defaults: cmd-shift-y unstages the selected hunk here.
    // Override g x in Git diffs to restore the current hunk and continue review.
    "bindings": {
      "g x": "git::RestoreAndNext",
      "ctrl-cmd-right": "git_panel::ToggleFocus",
    },
  },
]
