            "/home/vikram_orbio_earth/projects/orbio/orbio-github-wt"
          ]
        }
      ]
    }
  ],
  "telemetry": {
    "metrics": false,
    "diagnostics": false,
  },
  "vim_mode": true,
  // No need to horizontal scroll
  "soft_wrap": "editor_width",
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Tokyo Night Storm",
  },
  "icon_theme": {
    "mode": "system",
    "light": "Light Icon Theme",
    "dark": "Colored Zed Icons Theme Dark",
  },
  "file_finder": {
    "include_ignored": "all",
  },
  "terminal": {
    "working_directory": "current_project_directory",
    "font_family": "Hack Nerd Font Mono",
    "font_fallbacks": [
      "Hack Nerd Font Mono",
      "Hack Nerd Font",
      "Apple Color Emoji",
    ],
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_sign_in": false,
  },
  "show_completions_on_input": true,
  "languages": {
    "Python": {
      "language_servers": ["ty", "ruff", "!basedpyright"],
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
      },
      // NOTE: formatting through ruff doesn't work on remote machine
      // The only way to make it work currently is to copy the settings file to the remote machine.
      // So change aliases to first copy and then open zed.
      "formatter": {
        "language_server": {
          "name": "ruff",
        },
      },
    },
    "JSON": {
      "formatter": "prettier",
      "format_on_save": "on",
    },
  },
}
