// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "diff_view_style": "split",
  "confirm_quit": true,
  "agent_servers": {
    "opencode": {
      "default_config_options": {
        "model": "azure-cognitive-services/gpt-5.5",
        "mode": "plan",
        "effort": "high",
      },
      "type": "registry",
    },
  },
  "agent": {
    "default_profile": "write",
    "default_model": {
      "provider": "cursor",
      "model": "grok-4.5",
      "enable_thinking": true,
      "effort": "high"
    },
    "terminal_init_command": "title=\"$(basename \"$(dirname \"$PWD\")\")/$(basename \"$PWD\")\"; printf '\\033]2;%s\\007' \"$title\"; exec tmux new-session -A -s \"zed-$(basename \"$(dirname \"$PWD\")\")-$(basename \"$PWD\")\" -c \"$PWD\"",
  },
  "ssh_connections": [
    {
      "host": "localhost",
      "username": "vscode",
      "port": 2222,
      "args": [],
      "projects": [
        {
          "paths": [
            "/workspaces/Experiments/conf"
          ]
        }
      ]
    },
    {
      "host": "vm-us",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/vikram_orbio_earth/personal/dotfiles"
          ]
        },
        {
          "paths": [
            "/home/vikram_orbio_earth/personal/dotfiles-wt"
          ]
        },
        {
          "paths": [
            "/home/vikram_orbio_earth/personal/dotfiles-wt2"
          ]
        },
        {
          "paths": [
            "/home/vikram_orbio_earth/projects/orbio/meanderx/infrastructure"
          ]
        },
        {
          "paths": [
            "/home/vikram_orbio_earth/projects/orbio/meanderx/kunda-wt"
          ]
        },
        {
          "paths": [
            "/home/vikram_orbio_earth/projects/orbio/meanderx/kunda-wt2/./"
          ]
        },
        {
          "paths": [
            "/home/vikram_orbio_earth/projects/orbio/meanderx/kunda/./"
          ]
        },
        {
          "paths": [
            "/home/vikram_orbio_earth/projects/orbio/meanderx/meander-x-platform/./"
          ]
        },
        {
          "paths": [
            "/home/vikram_orbio_earth/projects/orbio/meanderx/meanderx-wt"
          ]
        },
        {
          "paths": [
            "/home/vikram_orbio_earth/projects/orbio/meanderx/meanderx-wt2"
