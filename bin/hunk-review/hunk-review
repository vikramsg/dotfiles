#!/bin/zsh

set -eu

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  print -u2 "hunk-review: current directory is not inside a Git repository"
  exit 1
}

cd "$repo_root"

status_output=$(git status --porcelain --untracked-files=normal) || {
  print -u2 "hunk-review: unable to read the working tree status"
  exit 1
}

if [[ -n "$status_output" ]]; then
  export HUNK_REVIEW_TARGET=working
  exec hunk diff --mode stack
fi

if ! git rev-parse --verify --quiet 'main^{commit}' >/dev/null; then
  print -u2 "hunk-review: working tree is clean and branch 'main' does not exist"
  exit 1
fi

if git diff --quiet main...HEAD --; then
  print "hunk-review: no changes since HEAD or since branching from main"
  exit 0
else
  comparison_status=$?
  if [[ $comparison_status -ne 1 ]]; then
    print -u2 "hunk-review: unable to compare the current branch with main"
    exit "$comparison_status"
  fi
fi

export HUNK_REVIEW_TARGET=main
exec hunk diff main... --mode stack
