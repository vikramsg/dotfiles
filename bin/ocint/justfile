# NOTE: Guardrail for just recipes in this repo:
# - Use $VAR for shell variable references.
# - Use $(...) for command substitution.
# - Do NOT use $$VAR for variable references.
# - $$ expands to shell PID and can corrupt paths.
# - Use {{...}} only for just-level interpolation.

package_root := justfile_directory()
workspace_root := package_root + "/../.."
uv_ocint := "uv run --directory '" + workspace_root + "' --package ocint --frozen"

# List available ocint commands
default:
    @just --justfile "{{justfile()}}" --list

# Run ocint package tests
test:
    {{uv_ocint}} pytest "{{justfile_directory()}}/tests"

# Run module boundary checks
tach:
    uv run --directory "{{justfile_directory()}}" --package ocint --frozen tach check --exact

# Run ocint static checks
check:
    @set -e; ROOTS="{{justfile_directory()}}/ocint {{justfile_directory()}}/scripts {{justfile_directory()}}/tests"; \
        {{uv_ocint}} ruff check $ROOTS; \
        {{uv_ocint}} ruff format --check $ROOTS; \
        {{uv_ocint}} ty check $ROOTS
    @just --justfile "{{justfile()}}" tach

# Install the OpenCode intelligence CLI
install:
    uv tool install "{{justfile_directory()}}" --force --no-cache

# Prepare release files on an explicit release branch
release-prepare version:
    uv run --directory "{{workspace_root}}" python "{{justfile_directory()}}/scripts/ocint_release.py" prepare "{{version}}"

# Read-only validation for a committed release branch
release-validate base title:
    uv run --directory "{{workspace_root}}" python "{{justfile_directory()}}/scripts/ocint_release.py" validate-pr --base "{{base}}" --base-ref main --title "{{title}}" --branch "$(git branch --show-current)"

# Smoke-test ocint state commands against the configured OpenCode DB when present
smoke-state:
    {{uv_ocint}} ocint state config
    @DB_EXISTS="$({{uv_ocint}} ocint state config --format json | python3 -c 'import json, sys; print(json.load(sys.stdin)["db_exists"])')"; \
        if [ "$DB_EXISTS" = "True" ]; then \
            {{uv_ocint}} ocint state schema; \
            {{uv_ocint}} ocint state summary --days 30; \
            {{uv_ocint}} ocint state sessions --days 30; \
            {{uv_ocint}} ocint state detailed --days 30; \
            {{uv_ocint}} ocint state summary --days 30 --format json; \
            {{uv_ocint}} ocint state sessions --days 30 --format json; \
            {{uv_ocint}} ocint state detailed --days 30 --format json; \
            {{uv_ocint}} ocint state query "SELECT COUNT(*) AS sessions FROM session"; \
        else \
            echo "Skipping DB-backed ocint state smoke commands because the resolved OpenCode DB does not exist."; \
        fi

# Smoke-test ocint ctx commands against a temp imported OpenCode fixture
smoke-ctx:
    {{uv_ocint}} ocint ctx docs show sql
    {{uv_ocint}} ocint ctx docs search "stable views"
    @set -e; \
        TMPDIR="$(mktemp -d /tmp/ocint-smoke-ctx.XXXXXX)"; \
        OPENCODE_DB="$TMPDIR/opencode.db" {{uv_ocint}} python3 -c 'import os; from pathlib import Path; from tests.support.opencode_db import create_opencode_db; create_opencode_db(Path(os.environ["OPENCODE_DB"]))'; \
        export OCINT_CTX_DB="$TMPDIR/ctx.sqlite"; \
        export OPENCODE_DB="$TMPDIR/opencode.db"; \
        {{uv_ocint}} ocint ctx import; \
        export OPENCODE_DB="$TMPDIR/missing-opencode.db"; \
        {{uv_ocint}} ocint ctx status; \
        {{uv_ocint}} ocint ctx status --json; \
        {{uv_ocint}} ocint ctx sources; \
        {{uv_ocint}} ocint ctx sources --json; \
        {{uv_ocint}} ocint ctx search "native event marker" --refresh off; \
        {{uv_ocint}} ocint ctx search "native event marker" --workspace "/work/repo-directory-only" --refresh off; \
        {{uv_ocint}} ocint ctx search "native event marker" --file "AGENTS.md" --refresh off; \
        {{uv_ocint}} ocint ctx search "native event marker" --since 30d --refresh off; \
        {{uv_ocint}} ocint ctx search "native event marker" --term "related term" --term "error text" --refresh off; \
        {{uv_ocint}} ocint ctx search "native event marker" --session "s-primary" --refresh off; \
        {{uv_ocint}} ocint ctx search "native event marker" --verbose --refresh off; \
        {{uv_ocint}} ocint ctx search "subagent only marker" --include-subagents --refresh off; \
        export OPENCODE_DB="$TMPDIR/opencode.db"; \
        {{uv_ocint}} ocint ctx search "native event marker"; \
        export OPENCODE_DB="$TMPDIR/missing-opencode.db"; \
        {{uv_ocint}} ocint ctx sql "SELECT provider, COUNT(*) AS sessions FROM ctx_sessions GROUP BY provider"; \
        {{uv_ocint}} ocint ctx sql "SELECT event_type, COUNT(*) AS events FROM ctx_events GROUP BY event_type ORDER BY events DESC"; \
        {{uv_ocint}} ocint ctx sql "SELECT path, provider, provider_session_id FROM ctx_files_touched LIMIT 20"; \
        {{uv_ocint}} ocint ctx sql "SELECT provider, source_type, name, sessions, events FROM ctx_sources"; \
        {{uv_ocint}} ocint ctx show session "s-primary" --mode lite --out "$TMPDIR/ocint-session-lite.txt"; \
        {{uv_ocint}} ocint ctx show session "s-primary" --mode full --out "$TMPDIR/ocint-session-full.txt"; \
        {{uv_ocint}} ocint ctx show session "s-primary" --format markdown --out "$TMPDIR/ocint-session.md"; \
        {{uv_ocint}} ocint ctx show event "p-primary-step" --window 5; \
        {{uv_ocint}} ocint ctx show event "p-primary-step" --window 0 --json; \
        {{uv_ocint}} ocint ctx locate session "s-primary"; \
        {{uv_ocint}} ocint ctx locate session "s-primary" --json; \
        {{uv_ocint}} ocint ctx locate event "p-primary-step"; \
        {{uv_ocint}} ocint ctx locate event "p-primary-step" --json

# Run all ocint smoke checks
smoke: smoke-state smoke-ctx smoke-daemon

# Smoke-test minimal daemon config discovery and its job schema
smoke-daemon:
    @set -e; \
        TMPDIR="$(mktemp -d /tmp/ocint-smoke-daemon.XXXXXX)"; \
        sed -e "s#~/.local/state/ocint/daemon.sqlite#$TMPDIR/control.sqlite#g" -e "s#~/.local/share/ocint/mirrors#$TMPDIR/mirrors#g" -e "s#~/.local/share/ocint/worktrees#$TMPDIR/worktrees#g" "{{justfile_directory()}}/config/daemon.example.toml" > "$TMPDIR/daemon.toml"; \
        OCINT_DAEMON_CONFIG="$TMPDIR/daemon.toml" {{uv_ocint}} ocint daemon config --path; \
        OCINT_DAEMON_CONFIG="$TMPDIR/daemon.toml" {{uv_ocint}} ocint daemon migrate; \
        CONTROL_DB="$TMPDIR/control.sqlite" {{uv_ocint}} python3 -c 'import os; from sqlalchemy import create_engine, inspect; assert set(inspect(create_engine("sqlite:///" + os.environ["CONTROL_DB"])).get_table_names()) == {"alembic_version", "coordinator_conversation", "coordinator_delivery", "coordinator_event", "coordinator_turn", "github_issue", "github_issue_comment", "job", "pull_request_ownership", "slack_channel", "slack_message", "slack_reply", "slack_thread", "task", "task_job", "task_message", "thread", "thread_message"}'
