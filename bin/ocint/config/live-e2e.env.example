# Copy to ~/.config/ocint/live-e2e.env and run:
# chmod 600 ~/.config/ocint/live-e2e.env
#
# This xoxp User OAuth token belongs only to the authorized test user through
# the `ocint E2E actor` Slack app. The explicit live harness uses it to post one
# marked root. Do not add it to daemon.env, a systemd EnvironmentFile, tracked
# configuration, argv, or output.
OCINT_E2E_SLACK_ACTOR_USER_TOKEN=
