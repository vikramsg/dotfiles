# Copy to ~/.config/ocint/daemon.env and run:
# chmod 600 ~/.config/ocint/daemon.env
# The generated systemd service loads this EnvironmentFile. DaemonSettings uses
# the API token for FastAPI bearer auth and GitHubClient uses the GitHub token
# for polling, comments, PR lookup, and PR creation. Neither token authenticates
# SSH, and OpenCode/validation subprocesses receive neither token. Do not add an
# OpenCode password or SSH_AUTH_SOCK.
# Provision reads an existing token with `gh auth token`; it never refreshes
# authentication or initiates OAuth/device flow.
OCINT_DAEMON_API_TOKEN=
OCINT_DAEMON_GITHUB_TOKEN=
# Required only when [slack] is configured.
OCINT_DAEMON_SLACK_BOT_TOKEN=
