#!/usr/bin/env bash

# Proxy xdg-open to a local Mac browser via an SSH-forwarded Unix socket.
# Strictly handles Linux-only forwarding, falling back to 'open' on macOS.

URL="$1"
SOCKET="$HOME/.opener.sock"

if [[ "$OSTYPE" == "darwin"* ]]; then
    # On Mac, just use the native open command
    open "$URL"
    exit 0
fi

if [[ "$OSTYPE" == "linux-gnu"* ]]; then
    if [ -S "$SOCKET" ]; then
        # Forward the URL to the configured Mac-side opener service.
        if ! printf '%s\n' "$URL" | nc -U "$SOCKET"; then
            printf '%s\n' "Error: browser tunnel failed; URL: $URL" >&2
            printf '%s\n' "On the Mac, run: just opener-tunnel" >&2
            exit 1
        fi
    else
        printf '%s\n' "Error: browser tunnel socket not found at $SOCKET; URL: $URL" >&2
        printf '%s\n' "On the Mac, run: just opener-tunnel" >&2
        exit 1
    fi
else
    # Fallback for other OS types
    echo "Unsupported OS for xdg-open proxy: $OSTYPE"
    echo "URL: $URL"
    exit 1
fi
