# NOTE: Guardrail for just recipes in this repo:
# - Use $VAR for shell variable references.
# - Use $(...) for command substitution.
# - Do NOT use $$VAR for variable references.
# - Use {{...}} only for just-level interpolation.

package_root := justfile_directory()
workspace_root := package_root + "/../.."
active_config := env_var_or_default("ZWM_CONFIG", env_var("HOME") + "/.config/zwm/config.json")

default:
    @just --justfile "{{justfile()}}" --list

# Run deterministic ZWM unit tests.
test:
    cd "{{package_root}}" && go test ./...

# Build the native ZWM binary for this machine.
build-local:
    @CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/zwm"; \
    mkdir -p "$CACHE_DIR" "$HOME/.local/bin"; \
    ARTIFACT="$(mktemp "$CACHE_DIR/zwm-local.XXXXXX")"; \
    trap 'rm -f "$ARTIFACT"' EXIT; \
    cd "{{package_root}}" && go build -o "$ARTIFACT" ./cmd/zwm; \
    chmod 755 "$ARTIFACT"; \
    mv -f "$ARTIFACT" "$HOME/.local/bin/zwm"

# Print the configured remote host.
remote-host:
    @jq -er '.host | strings | select(length > 0)' "{{active_config}}"

# Print the configured VM's Go target platform.
remote-platform:
    @set -e; HOST="$(just --justfile "{{justfile()}}" remote-host)"; \
    OS="$(ssh -T -o BatchMode=yes "$HOST" uname -s)"; \
    ARCH="$(ssh -T -o BatchMode=yes "$HOST" uname -m)"; \
    case "$OS/$ARCH" in \
        Linux/x86_64) printf 'linux/amd64\n' ;; \
        Linux/aarch64) printf 'linux/arm64\n' ;; \
        *) printf 'Unsupported remote platform: %s/%s\n' "$OS" "$ARCH" >&2; exit 1 ;; \
    esac

# Cross-compile ZWM for the configured VM and print the artifact path.
build-remote:
    @set -e; TARGET="$(just --justfile "{{justfile()}}" remote-platform)"; \
    GOOS="${TARGET%/*}"; \
    GOARCH="${TARGET#*/}"; \
    CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/zwm"; \
    mkdir -p "$CACHE_DIR"; \
    ARTIFACT="$(mktemp "$CACHE_DIR/zwm.XXXXXX")"; \
    cd "{{package_root}}" && GOOS="$GOOS" GOARCH="$GOARCH" go build -o "$ARTIFACT" ./cmd/zwm; \
    printf '%s\n' "$ARTIFACT"

# Copy a cross-compiled artifact to a unique path on the configured VM.
copy-remote artifact remote_name:
    @HOST="$(just --justfile "{{justfile()}}" remote-host)"; \
    ssh -T -o BatchMode=yes "$HOST" 'mkdir -p "$HOME/.local/bin"'; \
    rsync -az --partial -e 'ssh -T -o BatchMode=yes' "{{artifact}}" "$HOST:~/.local/bin/{{remote_name}}"

# Verify that the configured VM received the exact cross-compiled artifact.
verify-remote artifact remote_name:
    @HOST="$(just --justfile "{{justfile()}}" remote-host)"; \
    LOCAL_HASH="$(shasum -a 256 "{{artifact}}" | awk '{print $1}')"; \
    REMOTE_HASH="$(ssh -T -o BatchMode=yes "$HOST" 'sha256sum "$HOME/.local/bin/{{remote_name}}" | awk "{print \$1}"')"; \
    test "$LOCAL_HASH" = "$REMOTE_HASH"

# Atomically activate the copied ZWM binary on the configured VM.
install-remote remote_name:
    @HOST="$(just --justfile "{{justfile()}}" remote-host)"; \
    ssh -T -o BatchMode=yes "$HOST" 'chmod 755 "$HOME/.local/bin/{{remote_name}}" && mv -f "$HOME/.local/bin/{{remote_name}}" "$HOME/.local/bin/zwm"'

# Remove a per-run remote artifact after an interrupted install.
[private]
cleanup-remote remote_name:
    @HOST="$(just --justfile "{{justfile()}}" remote-host)"; \
    ssh -T -o BatchMode=yes "$HOST" 'rm -f "$HOME/.local/bin/{{remote_name}}"'

# Build ZWM locally, and deploy it to the configured VM from macOS.
install: build-local
    @if [ "$(uname -s)" = "Darwin" ]; then \
        set -e; ARTIFACT="$(just --justfile "{{justfile()}}" build-remote)"; \
        REMOTE_NAME="zwm.$(basename "$ARTIFACT").new"; \
        trap 'rm -f "$ARTIFACT"; just --justfile "{{justfile()}}" cleanup-remote "$REMOTE_NAME" >/dev/null 2>&1 || true' EXIT; \
        just --justfile "{{justfile()}}" copy-remote "$ARTIFACT" "$REMOTE_NAME"; \
        just --justfile "{{justfile()}}" verify-remote "$ARTIFACT" "$REMOTE_NAME"; \
        just --justfile "{{justfile()}}" install-remote "$REMOTE_NAME"; \
    else \
        echo "Skipping remote ZWM deployment: this host is not macOS."; \
    fi
