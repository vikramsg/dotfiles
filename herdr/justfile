# Herdr plugins declared in plugins.json and installed from GitHub.
#
# `install` adds declared plugins that are not installed yet; `update`
# reinstalls every declared plugin to refresh its managed checkout. Herdr
# stores the plugin source under its own runtime directory, so this repository
# only holds the declaration.

# Install declared plugins that are missing.
install: configure-sidebar
    #!/usr/bin/env bash
    set -euo pipefail

    plugins_file="{{justfile_directory()}}/plugins.json"
    installed="$(herdr plugin list --json | jq -r '.result.plugins[] | select(.source.kind == "github") | .plugin_id')"

    while IFS="$(printf '\t')" read -r id source ref; do
        [ -n "$source" ] || continue
        if printf '%s\n' "$installed" | grep -Fxq "$id"; then
            echo "already installed: $source"
            continue
        fi
        echo "installing: $source"
        if [ -n "$ref" ]; then
            herdr plugin install "$source" --ref "$ref" -y
        else
            herdr plugin install "$source" -y
        fi
    done < <(jq -r '.plugins[] | [.id, .source, (.ref // "")] | @tsv' "$plugins_file")

# Apply managed preferences before installation can trigger auto-open hooks.
configure-sidebar:
    #!/usr/bin/env bash
    set -euo pipefail

    state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/herdr/plugins/herdr-sidebar"
    mkdir -p "$state_dir"
    state_file="$state_dir/state.json"
    temporary_file="$(mktemp "$state_dir/state.json.XXXXXX")"
    trap 'rm -f "$temporary_file"' EXIT
    if [ -f "$state_file" ]; then
        jq -s '.[0] * .[1]' "$state_file" "{{justfile_directory()}}/sidebar-settings.json" > "$temporary_file"
    else
        cp "{{justfile_directory()}}/sidebar-settings.json" "$temporary_file"
    fi
    mv "$temporary_file" "$state_file"
    cp "{{justfile_directory()}}/sidebar-editor.txt" "$state_dir/editor-command.txt"

# Reinstall every declared plugin to refresh its managed checkout.
update: configure-sidebar
    #!/usr/bin/env bash
    set -euo pipefail

    plugins_file="{{justfile_directory()}}/plugins.json"
    while IFS="$(printf '\t')" read -r source ref; do
        [ -n "$source" ] || continue
        echo "updating: $source"
        if [ -n "$ref" ]; then
            herdr plugin install "$source" --ref "$ref" -y
        else
            herdr plugin install "$source" -y
        fi
    done < <(jq -r '.plugins[] | [.source, (.ref // "")] | @tsv' "$plugins_file")
