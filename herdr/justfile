# Herdr plugin installation from plugins.json, plus Herdr diagnostics.
#
# `install` adds declared plugins that are not installed yet; `update`
# reinstalls every declared plugin to refresh its managed checkout. Herdr
# stores the plugin source under its own runtime directory, so this repository
# only holds plugin declarations and user-editable configuration.
# Some plugins, such as herdr-navigator, need Cargo from `just brew` to build.

# Linux only: reads each server's environment from /proc and compares it with
# the PATH a fresh SSH-launched Bash gets from ~/.bashrc. See "Custom commands"
# in README.md.
#
# List running Herdr servers whose PATH is missing login entries.
env-check:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -d /proc/self ]; then
        echo "env-check reads /proc and only runs on Linux."
        exit 0
    fi
    expected="$(env -i HOME="$HOME" USER="$USER" bash -c '. "$HOME/.bashrc" >/dev/null 2>&1; printf "%s" "$PATH"')"
    if [ -z "$expected" ]; then
        echo "Could not read a reference PATH from ~/.bashrc."
        exit 1
    fi
    stale=0
    found=0
    for pid in $(pgrep -x herdr || true); do
        args="$(tr '\0' ' ' < "/proc/$pid/cmdline")"
        case " $args " in
            *" server "*) ;;
            *) continue ;;
        esac
        found=1
        server_path="$(tr '\0' '\n' < "/proc/$pid/environ" | sed -n 's/^PATH=//p')"
        missing=()
        IFS=: read -ra dirs <<< "$expected"
        for dir in "${dirs[@]}"; do
            case ":$server_path:" in
                *":$dir:"*) ;;
                *) missing+=("$dir") ;;
            esac
        done
        if [ "${#missing[@]}" -eq 0 ]; then
            echo "ok     pid $pid: $args"
        else
            stale=1
            echo "stale  pid $pid: $args"
            printf '         missing %s\n' "${missing[@]}"
        fi
    done
    if [ "$found" -eq 0 ]; then
        echo "No running Herdr servers."
    fi
    exit "$stale"

# Install declared plugins that are missing.
install:
    #!/usr/bin/env bash
    set -euo pipefail

    plugins_file="{{justfile_directory()}}/plugins.json"
    installed="$(herdr plugin list --json | jq -r '.result.plugins[] | select(.source.kind == "github") | "\(.source.owner)/\(.source.repo)"')"

    while IFS="$(printf '\t')" read -r source ref; do
        [ -n "$source" ] || continue
        if printf '%s\n' "$installed" | grep -Fxqi "$source"; then
            echo "already installed: $source"
            continue
        fi
        echo "installing: $source"
        if [ -n "$ref" ]; then
            herdr plugin install "$source" --ref "$ref" -y
        else
            herdr plugin install "$source" -y
        fi
    done < <(jq -r '.plugins[] | [.source, (.ref // "")] | @tsv' "$plugins_file")

# Reinstall every declared plugin to refresh its managed checkout.
update:
    #!/usr/bin/env bash
    set -euo pipefail

    plugins_file="{{justfile_directory()}}/plugins.json"
    while IFS="$(printf '\t')" read -r source ref; do
        [ -n "$source" ] || continue
        echo "updating: $source"
        if [ -n "$ref" ]; then
            herdr plugin install "$source" --ref "$ref" -y
        else
            herdr plugin install "$source" -y
        fi
    done < <(jq -r '.plugins[] | [.source, (.ref // "")] | @tsv' "$plugins_file")

# An agent integration is a hook Herdr writes into the agent's own config
# directory that reports the agent's state and session ID back to Herdr. For
# OpenCode that is plugins/herdr-agent-state.js, herdr-tui-session.js and a
# tui.jsonc entry under ~/.config/opencode.
#
# Without it, a server restart brings agent panes back as plain shells:
# `session.resume_agents_on_restore` defaults to true but can only relaunch
# agents whose integration reported a session ID. Herdr generates the hook
# files, so this repository only declares which integrations to install.
# Re-running replaces them with the version bundled in the installed Herdr;
# check with `herdr integration status`.
#
# Install Herdr's agent integrations.
integrations:
    herdr integration install opencode

# Link managed Reviewr settings without replacing an unmanaged config.
link-reviewr-config:
    @SOURCE="{{justfile_directory()}}/reviewr.toml"; \
        CONFIG_DIR="$HOME/.config/herdr/plugins/config/persiyanov.reviewr"; \
        TARGET="$CONFIG_DIR/config.toml"; \
        mkdir -p "$CONFIG_DIR"; \
        if [ -L "$TARGET" ] && [ "$(readlink "$TARGET")" = "$SOURCE" ]; then \
            :; \
        elif [ -e "$TARGET" ] || [ -L "$TARGET" ]; then \
            echo "ERROR: $TARGET exists and is not the managed symlink. Move or migrate it manually first."; \
            exit 1; \
        else \
            ln -s "$SOURCE" "$TARGET"; \
        fi
