{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:orchestration-state && npm run build:sandbox && npm run check:sandbox:v2 && npm run check:plugins",
    "build:orchestration-state": "node --check plugins2/orchestration-state.js",
    "build:sandbox": "tsc -p sandbox/tsconfig.json",
    "check:sandbox:v2": "tsc -p sandbox/cli-v2/tsconfig.json",
    "sandbox": "npm run build:sandbox --silent && node sandbox/dist/sandbox-cli.js",
    "sandbox:v2": "node sandbox/cli-v2/index.ts",
    "test:sandbox": "npm run build:sandbox --silent && node --test sandbox/sandbox-cli.test.mjs",
    "test:sandbox:v2": "vitest run sandbox/cli-v2",
    "test:plugins": "vitest run tests/plugins",
    "check:plugins": "tsc -p tsconfig.plugins.json"
  },
  "dependencies": {
    "@opencode-ai/ai": "0.0.0-beta-17595",
    "@opencode-ai/plugin": "0.0.0-beta-17595",
    "cac": "^7.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opencode-ai/theme": "0.0.0-beta-17595",
    "@opentui/core": "0.5.3",
    "@opentui/solid": "0.5.3",
    "@types/json-schema": "7.0.15",
    "@types/node": "latest",
    "solid-js": "1.9.12",
    "tsx": "^4.22.3",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  }
}
