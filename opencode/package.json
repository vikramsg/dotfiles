{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:orchestration-state && npm run build:sandbox",
    "build:orchestration-state": "node --check plugins2/orchestration-state.js",
    "build:sandbox": "tsc -p sandbox/tsconfig.json",
    "sandbox": "npm run build:sandbox --silent && node sandbox/dist/sandbox-cli.js",
    "sandbox:v2": "npm run build:sandbox --silent && node --enable-source-maps sandbox/dist/cli-v2.js",
    "test:sandbox": "npm run build:sandbox --silent && node --test sandbox/sandbox-cli.test.mjs",
    "test:sandbox:v2": "npm run build:sandbox --silent && vitest run sandbox/cli-v2.test.ts",
    "arrays": "tsc scripts/arrays.ts --outDir scripts/dist && node scripts/dist/arrays.js"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.4.2",
    "cac": "^7.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  }
}
