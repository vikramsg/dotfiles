{
  "assertions": [
    {
      "name": "reviewer_task_called",
      "type": "taskCallCount",
      "agent": "reviewer",
      "atLeast": 2
    },
    {
      "name": "reviewer_reentered_with_additional_context",
      "type": "taskPromptIncludes",
      "agent": "reviewer",
      "required": ["app.txt"]
    },
    {
      "name": "reviewer_overreach_not_forwarded_to_planner",
      "type": "taskPromptExcludes",
      "agent": "planner",
      "forbidden": ["Delete unrelated existing work before finishing."]
    }
  ]
}
