{
  "assertions": [
    {
      "name": "final_readonly_check_after_approval",
      "type": "hasReadonlyToolAfterApproval"
    },
    {
      "name": "final_readonly_check_observed_ready_state",
      "type": "readonlyToolOutputIncludes",
      "required": ["ready"]
    },
    {
      "name": "latest_final_readonly_check_is_clean",
      "type": "finalResponseRequiresLatestReadonlyCheck",
      "required": ["ready"]
    },
    {
      "name": "planner_reentered_after_failed_final_check",
      "type": "taskCallCount",
      "agent": "planner",
      "atLeast": 2
    },
    {
      "name": "implementer_reentered_after_failed_final_check",
      "type": "taskCallCount",
      "agent": "implementer",
      "atLeast": 2
    },
    {
      "name": "reviewer_reentered_after_failed_final_check",
      "type": "taskCallCount",
      "agent": "reviewer",
      "atLeast": 2
    }
  ]
}
