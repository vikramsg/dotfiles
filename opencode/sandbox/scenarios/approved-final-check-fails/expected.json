{
  "assertions": [
    {
      "name": "final_readonly_check_after_approval",
      "type": "hasReadonlyToolAfterApproval"
    },
    {
      "name": "final_readonly_check_observed_pending_state",
      "type": "readonlyToolOutputIncludes",
      "required": ["pending"]
    },
    {
      "name": "no_success_claim_without_final_check",
      "type": "finalResponseDoesNotClaimSuccessWithoutFinalCheck"
    },
    {
      "name": "planner_reentered_after_failed_final_check",
      "type": "taskCallCount",
      "agent": "planner",
      "atLeast": 2
    },
    {
      "name": "implementer_reentered_after_failed_final_check",
      "type": "taskCallCount",
      "agent": "implementer",
      "atLeast": 2
    },
    {
      "name": "reviewer_reentered_after_failed_final_check",
      "type": "taskCallCount",
      "agent": "reviewer",
      "atLeast": 2
    }
  ]
}
