{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "plugins/**/*.ts",
    "plugins-v1/**/*.ts",
    "tests/plugins/**/*.ts"
  ],
  "exclude": ["tests/plugins/mode-transition-reminder.test.ts"]
}
