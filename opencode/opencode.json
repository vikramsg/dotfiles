{
    "$schema": "https://opencode.ai/config.json",
    "model": "azure-cognitive-services/gpt-5.5",
    "instructions": ["~/.config/opencode/rules.md"],
    "permission": {
        "bash": {
            "*rm*.sqlite*": "deny",
            "*rm*.db*": "deny"
        },
        "external_directory": {
            "/tmp/**": "allow",
            "/private/tmp/**": "allow"
        },
        "read": {
            "*.local/**": "allow",
            "*.config/**": "allow",
            "/opt/homebrew/lib/**": "allow",
            "~/go/**": "allow"
        },
        "glob": {
            "*.local/**": "allow",
            "*.config/**": "allow",
            "/opt/homebrew/lib/**": "allow",
            "~/go/**": "allow"
        },
        "grep": {
            "*.local/**": "allow",
            "*.config/**": "allow",
            "/opt/homebrew/lib/**": "allow",
            "~/go/**": "allow"
        }
    },
    "agent": {
        "build": {
            "options": {
                "serviceTier": "priority"
            }
        },
        "plan": {
            "prompt": "{file:./prompts/plan-gpt.txt}",
            "options": {
                "serviceTier": "priority"
            }
        }
    },
    "plugin": ["opencode-websearch-cited@1.2.0"],
    "lsp": false,
    "formatter": false,
    "provider": {
        "google": {
            "options": {
                "websearch_cited": {
                    "model": "gemini-3.5-flash"
                }
            }
        },
        "azure-cognitive-services": {
            "options": {
                "baseURL": "https://eastus2.api.cognitive.microsoft.com/openai"
            },
            "models": {
                "gpt-5.5": {
                    "id": "gpt-5.5",
                    "name": "gpt-5.5",
                    "options": {
                        "reasoningEffort": "high",
                        "reasoningSummary": "auto"
                    },
                    "modalities": {
                        "input": ["text", "image", "pdf"],
                        "output": ["text"]
                    }
                },
                "gpt-5.4": {
                    "id": "gpt-5.4",
                    "name": "gpt-5.4",
                    "modalities": {
                        "input": ["text", "image", "pdf"],
                        "output": ["text"]
                    }
                },
                "gpt-5.3-codex": {
                    "id": "gpt-5.3-codex",
                    "name": "gpt-5.3-codex",
                    "modalities": {
                        "input": ["text", "image"],
                        "output": ["text"]
                    }
                }
            }
        }
    }
}
