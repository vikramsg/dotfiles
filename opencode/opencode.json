{
    "$schema": "https://opencode.ai/config.json",
    "model": "azure-cognitive-services/gpt-5.6-sol",
    "instructions": ["~/.config/opencode/rules.md"],
    "permissions": [
        {
            "action": "shell",
            "resource": "*rm*.sqlite*",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "*rm*.db*",
            "effect": "deny"
        },
        {
            "action": "external_directory",
            "resource": "/tmp/**",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "/private/tmp/**",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "*.local/**",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "*.config/**",
            "effect": "allow"
        },
        {
            "action": "websearch",
            "resource": "*",
            "effect": "allow"
        }
    ],
    "agent": {
        "build": {
            "options": {
                "serviceTier": "priority"
            }
        },
        "explore": {
            "model": "azure-cognitive-services/gpt-5.6-terra",
            "options": {
                "reasoningEffort": "medium"
            }
        },
        "general": {
            "model": "azure-cognitive-services/gpt-5.6-terra",
            "options": {
                "reasoningEffort": "medium"
            }
        }
    },
    "lsp": false,
    "formatter": false,
    "provider": {
        "azure-cognitive-services": {
            "options": {
                "baseURL": "https://eastus2.api.cognitive.microsoft.com/openai/v1"
            },
            "models": {
                "gpt-5.6-sol": {
                    "id": "gpt-5.6-sol",
                    "name": "gpt-5.6-sol",
                    "options": {
                        "reasoningEffort": "medium",
                        "reasoningSummary": "auto",
                        "serviceTier": "priority"
                    },
                    "modalities": {
                        "input": ["text", "image", "pdf"],
                        "output": ["text"]
                    }
                },
                "gpt-5.6-terra": {
                    "id": "gpt-5.6-terra",
                    "name": "gpt-5.6-terra",
                    "options": {
                        "reasoningEffort": "high",
                        "reasoningSummary": "auto"
                    },
                    "modalities": {
                        "input": ["text", "image", "pdf"],
                        "output": ["text"]
                    }
                },
                "gpt-5.5": {
                    "id": "gpt-5.5",
                    "name": "gpt-5.5",
                    "options": {
                        "reasoningEffort": "high",
                        "reasoningSummary": "auto"
                    },
                    "modalities": {
                        "input": ["text", "image", "pdf"],
                        "output": ["text"]
                    }
                }
            }
        }
    }
}
