{
  "$schema": "https://opencode.ai/config.json",
  "model": "azure-openai/gpt-5-4",
  "instructions": ["~/.config/opencode/rules.md"],
  "permission": {
    "bash": {
      "*rm*.sqlite*": "deny",
      "*rm*.db*": "deny"
    },
    "external_directory": {
      "/tmp/**": "allow",
      "/private/tmp/**": "allow"
    },
    "read": {
      "*.local/**": "allow",
      "*.config/**": "allow",
      "/opt/homebrew/lib/**": "allow",
      "~/go/**": "allow"
    },
    "glob": {
      "*.local/**": "allow",
      "*.config/**": "allow",
      "/opt/homebrew/lib/**": "allow",
      "~/go/**": "allow"
    },
    "grep": {
      "*.local/**": "allow",
      "*.config/**": "allow",
      "/opt/homebrew/lib/**": "allow",
      "~/go/**": "allow"
    }
  },
  "agent": {
    "build": {
      "options": {
        "serviceTier": "priority"
      }
    },
    "plan": {
      "options": {
        "serviceTier": "priority"
      }
    }
  },
  "plugin": [
    "opencode-websearch-cited@1.2.0",
    "./plugins/orchestration-state.js"
  ],
  "lsp": false,
  "formatter": false,
  "provider": {
    "google": {
      "options": {
        "websearch_cited": {
          "model": "gemini-3-flash-preview"
        }
      }
    },
    "azure-openai": {
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "https://eastus2.api.cognitive.microsoft.com/openai/v1"
      },
      "models": {
        "gpt-5.5": {
          "id": "gpt-5.5",
          "name": "gpt-5.5",
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        },
        "gpt-5.4": {
          "id": "gpt-5.4",
          "name": "gpt-5.4",
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        },
        "gpt-5.3-codex": {
          "id": "gpt-5.3-codex",
          "name": "gpt-5.3-codex",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    }
  }
}
