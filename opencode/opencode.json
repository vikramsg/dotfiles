{
  "$schema": "https://opencode.ai/config.json",
  "update": "notify",
  "model": "azure/gpt-5.6-sol",
  "permissions": [
    {
      "action": "shell",
      "resource": "rm *.sqlite*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm *.db*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/private/tmp/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*.local/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*.config/**",
      "effect": "allow"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "agents": {
    "build": {
      "request": {
        "body": {
          "serviceTier": "priority"
        }
      }
    },
    "explore": {
      "model": "azure/gpt-5.6-terra#medium"
    },
    "general": {
      "model": "azure/gpt-5.6-terra#medium"
    }
  },
  "lsp": false,
  "formatter": false,
  "providers": {
    "azure": {
      "settings": {
        "resourceName": "orbio-p-eastus2-openai",
        "baseURL": "https://eastus2.api.cognitive.microsoft.com/openai/v1"
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "gpt-5.6-sol",
          "modelID": "gpt-5.6-sol",
          "settings": {
            "reasoningEffort": "medium",
            "reasoningSummary": "auto",
            "serviceTier": "priority"
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gpt-5.6-terra": {
          "name": "gpt-5.6-terra",
          "modelID": "gpt-5.6-terra",
          "settings": {
            "reasoningEffort": "high",
            "reasoningSummary": "auto"
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gpt-5.6-luna": {
          "name": "gpt-5.6-luna",
          "modelID": "gpt-5.6-luna",
          "settings": {
            "reasoningEffort": "medium",
            "reasoningSummary": "auto",
            "serviceTier": "priority"
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gpt-6-astra": {
          "name": "gpt-6-astra",
          "modelID": "gpt-6-astra",
          "settings": {
            "reasoningEffort": "medium",
            "reasoningSummary": "auto",
            "serviceTier": "priority"
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "provider": {
    "cursor-acp": {
      "name": "Cursor",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:32124/v1"
      },
      "models": {
        "auto": {
          "name": "Auto",
          "cost": {
            "input": 1.25,
            "output": 6,
            "cache_read": 0.25,
            "cache_write": 1.25
          }
        },
        "grok": {
          "name": "Grok"
        },
        "cursor-grok-4.6-high-fast": {
          "name": "Cursor Grok 4.6 Fast"
        },
        "composer-2.5": {
          "name": "Composer 2.5"
        },
        "cursor-grok-4.6-low": {
          "name": "Cursor Grok 4.6 Low"
        },
        "cursor-grok-4.6-low-fast": {
          "name": "Cursor Grok 4.6 Low Fast"
        },
        "cursor-grok-4.6-medium": {
          "name": "Cursor Grok 4.6 Medium"
        },
        "cursor-grok-4.6-medium-fast": {
          "name": "Cursor Grok 4.6 Medium Fast"
        },
        "cursor-grok-4.6-high": {
          "name": "Cursor Grok 4.6"
        },
        "cursor-grok-4.6-xhigh": {
          "name": "Cursor Grok 4.6 Extra High"
        },
        "cursor-grok-4.6-xhigh-fast": {
          "name": "Cursor Grok 4.6 Extra High Fast"
        },
        "composer-2.5-fast": {
          "name": "Composer 2.5 Fast"
        },
        "muse-spark-1.3-minimal": {
          "name": "Muse Spark 1.3 1M Minimal"
        },
        "muse-spark-1.3-low": {
          "name": "Muse Spark 1.3 1M Low"
        },
        "muse-spark-1.3-medium": {
          "name": "Muse Spark 1.3 1M Medium"
        },
        "muse-spark-1.3-high": {
          "name": "Muse Spark 1.3 1M"
        },
        "muse-spark-1.3-xhigh": {
          "name": "Muse Spark 1.3 1M Extra High"
        },
        "muse-spark-1.3-max": {
          "name": "Muse Spark 1.3 1M Max"
        },
        "kimi-k2.7-code": {
          "name": "Kimi K2.7 Code"
        }
      }
    }
  }
}
