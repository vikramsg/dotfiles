{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/.config/opencode/rules.md"],
  "permission": {
    "bash": {
      "*rm*.sqlite*": "deny",
      "*rm*.db*": "deny"
    },
    "external_directory": {
      "/tmp/**": "allow"
    }
  },
  "plugin": ["opencode-websearch-cited@1.2.0"],
  "lsp": false,
  "formatter": false,
  "provider": {
    "google": {
      "options": {
        "websearch_cited": {
          "model": "gemini-3-flash-preview"
        }
      }
    }
  },
  "mcp": {
    "miro-mcp": {
      "type": "remote",
      "url": "https://mcp.miro.com/",
      "enabled": true
    }
  }
}
