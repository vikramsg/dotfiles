{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/.config/opencode/rules.md"],
  "permission": {
    "bash": {
      "*rm*.sqlite*": "deny",
      "*rm*.db*": "deny"
    },
    "external_directory": {
      "/tmp/**": "allow"
    },
    "read": {
      "~/.local/**": "allow",
      "/opt/homebrew/lib/**": "allow"
    },
    "glob": {
      "*.local/**": "allow",
      "/opt/homebrew/lib/**": "allow"
    },
    "grep": {
      "*.local/**": "allow",
      "/opt/homebrew/lib/**": "allow"
    }
  },
  "agent": {
    "build": {
      "options": {
        "serviceTier": "priority"
      }
    },
    "plan": {
      "options": {
        "serviceTier": "priority"
      }
    }
  },
  "plugin": ["opencode-websearch-cited@1.2.0"],
  "lsp": false,
  "formatter": false,
  "provider": {
    "google": {
      "options": {
        "websearch_cited": {
          "model": "gemini-3-flash-preview"
        }
      }
    },
    "azure-openai": {
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "https://eastus2.api.cognitive.microsoft.com/openai/v1"
      },
      "models": {
        "gpt-5-4": {
          "id": "gpt-5-4",
          "name": "gpt-5-4",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "gpt-5-3-codex": {
          "id": "gpt-5-3-codex",
          "name": "gpt-5-3-codex",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    }
  },
  "mcp": {
    "miro-mcp": {
      "type": "remote",
      "url": "https://mcp.miro.com/",
      "enabled": true
    }
  }
}
