{
  "$schema": "https://opencode.ai/config.json",
  "update": "notify",
  "model": "claude-agent/opus",
  "permissions": [
    {
      "action": "shell",
      "resource": "rm *.sqlite*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm *.db*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/private/tmp/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*.local/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*.config/**",
      "effect": "allow"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "agents": {
    "explore": {
      "model": "claude-agent/sonnet#high"
    },
    "general": {
      "model": "claude-agent/sonnet#high"
    }
  },
  "lsp": false,
  "formatter": false,
  "providers": {
    "azure": {
      "settings": {
        "resourceName": "orbio-p-eastus2-openai",
        "baseURL": "https://eastus2.api.cognitive.microsoft.com/openai/v1"
      },
      "models": {
        "gpt-6.1-sol": {
          "name": "gpt-6.1-sol",
          "modelID": "gpt-6.1-sol",
          "settings": {
            "reasoningEffort": "medium",
            "reasoningSummary": "auto",
            "serviceTier": "priority"
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        },
        "gpt-6-sol": {
          "name": "gpt-6-sol",
          "modelID": "gpt-6-sol",
          "settings": {
            "reasoningEffort": "medium",
            "reasoningSummary": "auto",
            "serviceTier": "priority"
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        },
        "gpt-6-luna": {
          "name": "gpt-6-luna",
          "modelID": "gpt-6-luna",
          "settings": {
            "reasoningEffort": "medium",
            "reasoningSummary": "auto",
            "serviceTier": "priority"
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        },
        "gpt-6-astra": {
          "name": "gpt-6-astra",
          "modelID": "gpt-6-astra",
          "settings": {
            "reasoningEffort": "medium",
            "reasoningSummary": "auto",
            "serviceTier": "priority"
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        }
      }
    }
  }
}
