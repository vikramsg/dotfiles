{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.config/opencode/rules.md"
  ],
  "permission": {
    "bash": "allow",
    "edit": {
      "**/*.sqlite": "deny",
      "**/*.db": "deny",
      "**": "allow"
    },
    "write": {
      "**/*.sqlite": "deny",
      "**/*.db": "deny",
      "**": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "read": "allow"
  }
}
