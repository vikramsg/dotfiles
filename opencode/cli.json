{
  "keybinds": {
    "agent.cycle": "tab",
    "input.newline": "shift+return,alt+return,ctrl+return,ctrl+j",
    "model.cycle_favorite": "<leader>right",
    "model.cycle_favorite_reverse": "<leader>left",
    "prompt.queue": "<leader>return"
  },
  "plugins": [
    "./plugins/tui/zed-bell-v2.ts",
    "./plugins/tui/herdr-tui-session-v2.ts"
  ],
  "tabs": {
    "enabled": false
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "show"
  },
  "animations": true
}
