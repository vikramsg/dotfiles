Host vm vm.*
    RequestTTY yes
    # Remove stale local UNIX sockets during reconnects.
    StreamLocalBindUnlink yes

    # Autossh resilience: force SSH to fail fast after sleep/wake so autossh can retry.
    # Client sends keepalive probes every 15 seconds.
    ServerAliveInterval 15
    # After 3 missed probes (45s), SSH exits instead of hanging forever.
    ServerAliveCountMax 3
    # If any port forward cannot bind on reconnect, fail hard and let autossh restart.
    ExitOnForwardFailure yes

    # Local development forwards that should always come back after reconnect.
    LocalForward 5173 localhost:5173
    LocalForward 8080 localhost:8080
    LocalForward 8081 localhost:8081
    LocalForward 19876 localhost:19876
    LocalForward 54321 localhost:54321
    LocalForward 54323 localhost:54323

Host vm.dotfiles
    # -d detaches ghost clients left behind by stale SSH sessions.
    RemoteCommand /home/linuxbrew/.linuxbrew/bin/tmux a -d -t dotfiles

Host vm.kunda
    # -d detaches ghost clients left behind by stale SSH sessions.
    RemoteCommand /home/linuxbrew/.linuxbrew/bin/tmux a -d -t kunda

Host vm.mx
    # -d detaches ghost clients left behind by stale SSH sessions.
    RemoteCommand /home/linuxbrew/.linuxbrew/bin/tmux a -d -t mx

Host vm.btop
    # -d detaches ghost clients left behind by stale SSH sessions.
    RemoteCommand /home/linuxbrew/.linuxbrew/bin/tmux a -d -t btop
