new file mode 100644
index 0000000..b659dce
--- /dev/null
+++ b/lua/differ/syntax/worker.lua
@@ -0,0 +1,39 @@
+local payload = vim.mpack.decode(io.stdin:read("*a"))
+vim.opt.runtimepath = payload.runtime_paths
+local syntax = require("differ.syntax")
+local chunk_size = 64
+for job_index, job in ipairs(payload.jobs) do
+    local model = require("differ.model.diff").build(job.model)
+    local column
+    if job.render_opts then
+        local columns = require("differ.render").render(model, job.render_opts).columns
+        for _, candidate in ipairs(columns) do
+            if candidate.side == job.side or candidate.side == "unified" then
+                column = candidate
+                break
+            end
+        end
+    else
+        column = { side = job.side, map = job.map }
+    end
+    local marks = syntax.collect(column, model)
+    if #marks == 0 then
+        local encoded = vim.mpack.encode({ job = job_index, marks = {} })
+        io.stdout:write(string.format("%08x", #encoded), encoded)
+    else
+        for first = 1, #marks, chunk_size do
+            local compact = {}
+            for index = first, math.min(first + chunk_size - 1, #marks) do
+                local mark = marks[index]
+                compact[#compact + 1] = { mark.row, mark.col_start, mark.col_end, mark.hl }
+            end
+            local encoded = vim.mpack.encode({
+                job = job_index,
+                marks = compact,
+            })
+            io.stdout:write(string.format("%08x", #encoded), encoded)
+        end
+    end
+end
+io.stdout:flush()
+vim.cmd("qa!")
