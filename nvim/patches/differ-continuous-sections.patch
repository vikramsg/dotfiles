diff --git a/lua/differ/git/async.lua b/lua/differ/git/async.lua
new file mode 100644
index 0000000..d8fa869
--- /dev/null
+++ b/lua/differ/git/async.lua
@@ -0,0 +1,71 @@
+local M = {}
+
+local limit = 1
+local batch_size = 4
+local active = 0
+local queue = {}
+local scheduled = false
+local module_path = debug.getinfo(1, "S").source:sub(2)
+local worker_path = vim.fs.joinpath(vim.fs.dirname(module_path), "worker.lua")
+
+local function command(payload, callback)
+    payload.runtime_paths = vim.api.nvim_list_runtime_paths()
+    vim.system({ "nice", "-n", "10", vim.v.progpath, "--headless", "--clean", "-l", worker_path }, {
+        stdin = vim.mpack.encode(payload),
+    }, function(result)
+        vim.schedule(function()
+            if result.code ~= 0 then
+                return callback(nil, vim.trim(result.stderr or "git worker failed"))
+            end
+            local ok, decoded = pcall(vim.mpack.decode, result.stdout or "")
+            if not ok then
+                return callback(nil, tostring(decoded))
+            end
+            callback(decoded)
+        end)
+    end)
+end
+
+function M.list(root, args, callback)
+    command({ action = "list", root = root, args = args }, function(result, err)
+        if not result then
+            return callback(nil, err)
+        end
+        callback(result.sections, result.err, result.source)
+    end)
+end
+
+local function pump()
+    scheduled = false
+    while active < limit and #queue > 0 do
+        local jobs = {}
+        for _ = 1, math.min(batch_size, #queue) do
+            jobs[#jobs + 1] = table.remove(queue, 1)
+        end
+        active = active + 1
+        local requests = {}
+        for i, job in ipairs(jobs) do
+            requests[i] = { source = job.source, root = job.root, entry = job.entry }
+        end
+        command({ action = "models", requests = requests }, function(results, err)
+            active = active - 1
+            for i, job in ipairs(jobs) do
+                local index, target = i, job
+                vim.defer_fn(function()
+                    target.callback(results and results[index] or nil, err)
+                end, index - 1)
+            end
+            pump()
+        end)
+    end
+end
+
+function M.model(source, root, entry, callback)
+    queue[#queue + 1] = { source = source, root = root, entry = entry, callback = callback }
+    if not scheduled then
+        scheduled = true
+        vim.defer_fn(pump, 2)
+    end
+end
+
+return M
