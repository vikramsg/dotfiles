diff --git a/lua/differ/git/worker.lua b/lua/differ/git/worker.lua
new file mode 100644
index 0000000..b9aea94
--- /dev/null
+++ b/lua/differ/git/worker.lua
@@ -0,0 +1,32 @@
+local payload = vim.mpack.decode(io.stdin:read("*a"))
+vim.opt.runtimepath = payload.runtime_paths
+local git = require("differ.git")
+if payload.action == "list" then
+    local source = git.resolve(require("differ.git.rev").source(payload.args), payload.root)
+    if not source then
+        io.stdout:write(vim.mpack.encode({ err = "could not resolve comparison" }))
+    elseif #payload.args == 0 then
+        local sections, err = git.status_sections(payload.root)
+        sections = vim.tbl_filter(function(section)
+            return #section.entries > 0
+        end, sections)
+        io.stdout:write(vim.mpack.encode({ sections = sections, err = err, source = source }))
+    else
+        local entries, err = git.file_entries(source, payload.root)
+        io.stdout:write(
+            vim.mpack.encode({
+                sections = { { title = "Changes", entries = entries } },
+                err = err,
+                source = source,
+            })
+        )
+    end
+else
+    local models = {}
+    for i, request in ipairs(payload.requests) do
+        models[i] = git.model(request.source, request.root, request.entry)
+    end
+    io.stdout:write(vim.mpack.encode(models))
+end
+io.stdout:flush()
+vim.cmd("qa!")
