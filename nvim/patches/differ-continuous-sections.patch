diff --git a/lua/differ/syntax/async.lua b/lua/differ/syntax/async.lua
new file mode 100644
index 0000000..a997ede
--- /dev/null
+++ b/lua/differ/syntax/async.lua
@@ -0,0 +1,135 @@
+local M = {}
+
+local process_limit = 1
+local files_per_process = 32
+local active = 0
+local queue = {}
+local scheduled = false
+local module_path = debug.getinfo(1, "S").source:sub(2)
+local worker_path = vim.fs.joinpath(vim.fs.dirname(module_path), "worker.lua")
+
+-- Packed array records avoid a hash table per capture in the editor. Consumers
+-- retain the same named source-coordinate fields without another allocation.
+local fields = { row = 1, col_start = 2, col_end = 3, hl = 4 }
+local mark_record = {
+    __index = function(mark, field)
+        return rawget(mark, fields[field])
+    end,
+}
+
+local function decode_frames(raw, jobs, done)
+    local offset, decoded = 1, {}
+    for i = 1, #jobs do
+        decoded[i] = {}
+    end
+    local function batch()
+        local started = (vim.uv or vim.loop).hrtime()
+        while offset <= #raw do
+            local size = tonumber(raw:sub(offset, offset + 7), 16)
+            if not size then
+                return done(nil, "invalid syntax worker frame")
+            end
+            offset = offset + 8
+            local ok, frame = pcall(vim.mpack.decode, raw:sub(offset, offset + size - 1))
+            if not ok then
+                return done(nil, tostring(frame))
+            end
+            offset = offset + size
+            for _, mark in ipairs(frame.marks) do
+                decoded[frame.job][#decoded[frame.job] + 1] = setmetatable(mark, mark_record)
+            end
+            if ((vim.uv or vim.loop).hrtime() - started) / 1e6 >= 2 then
+                return vim.defer_fn(batch, 1)
+            end
+        end
+        done(decoded)
+    end
+    batch()
+end
+
+local function pump()
+    scheduled = false
+    while active < process_limit and #queue > 0 do
+        local jobs = {}
+        for _ = 1, math.min(files_per_process, #queue) do
+            jobs[#jobs + 1] = table.remove(queue, 1)
+        end
+        active = active + 1
+        local input = {}
+        for i, job in ipairs(jobs) do
+            input[i] = {
+                model = {
+                    path = job.model.path,
+                    old_text = job.model.old_text,
+                    new_text = job.model.new_text,
+                },
+                side = job.column.side,
+                map = not job.render_opts and {
+                    from_old = job.column.map.from_old,
+                    from_new = job.column.map.from_new,
+                } or nil,
+                render_opts = job.render_opts,
+            }
+        end
+        local ok, payload = pcall(vim.mpack.encode, {
+            jobs = input,
+            runtime_paths = vim.api.nvim_list_runtime_paths(),
+        })
+        if not ok then
+            active = active - 1
+            for _, job in ipairs(jobs) do
+                vim.schedule(function()
+                    job.callback(nil, tostring(payload))
+                end)
+            end
+        else
+            local spawned, spawn_err = pcall(vim.system, {
+                "nice",
+                "-n",
+                "10",
+                vim.v.progpath,
+                "--headless",
+                "--clean",
+                "-l",
+                worker_path,
+            }, { stdin = payload }, function(result)
+                vim.schedule(function()
+                    local function finish(results, decode_err)
+                        active = active - 1
+                        for i, job in ipairs(jobs) do
+                            job.callback(results and results[i] or nil, decode_err)
+                        end
+                        pump()
+                    end
+                    if result.code ~= 0 then
+                        return finish(nil, vim.trim(result.stderr or "syntax worker failed"))
+                    end
+                    decode_frames(result.stdout or "", jobs, finish)
+                end)
+            end)
+            if not spawned then
+                active = active - 1
+                for _, job in ipairs(jobs) do
+                    vim.schedule(function()
+                        job.callback(nil, tostring(spawn_err))
+                    end)
+                end
+            end
+        end
+    end
+    if active < process_limit and #queue > 0 and not scheduled then
+        scheduled = true
+        vim.defer_fn(pump, 1)
+    end
+end
+
+function M.collect(column, model, callback, render_opts)
+    queue[#queue + 1] =
+        { column = column, model = model, callback = callback, render_opts = render_opts }
+    if not scheduled then
+        scheduled = true
+        vim.defer_fn(pump, 2)
+    end
+end
+
+return M
