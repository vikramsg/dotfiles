diff --git a/lua/differ/render/async.lua b/lua/differ/render/async.lua
new file mode 100644
index 0000000..bec236e
--- /dev/null
+++ b/lua/differ/render/async.lua
@@ -0,0 +1,92 @@
+local LineMap = require("differ.render.linemap")
+local M = {}
+
+local module_path = debug.getinfo(1, "S").source:sub(2)
+local lua_root = vim.fs.dirname(vim.fs.dirname(vim.fs.dirname(module_path)))
+local worker_package_path = lua_root .. "/?.lua;" .. lua_root .. "/?/init.lua"
+
+function M.render(model, opts, callback)
+    local payload = vim.mpack.encode({ model = model, opts = opts })
+    local work
+    work = (vim.uv or vim.loop).new_work(function(encoded, lua_path)
+        package.path = lua_path
+        local ok, result = pcall(function()
+            local input = vim.mpack.decode(encoded)
+            local output = require("differ.render").render(input.model, input.opts)
+            local columns = {}
+            local codes = { context = "c", old = "o", new = "n", meta = "m", filler = "f" }
+            for ci, column in ipairs(output.columns) do
+                local records, spans = {}, {}
+                for index, item in ipairs(column.map.lines) do
+                    records[index] = table.concat({
+                        codes[item.kind],
+                        tostring(item.old or 0),
+                        tostring(item.new or 0),
+                        tostring(item.hunk or 0),
+                    }, ",")
+                    if item.spans then
+                        spans[index] = item.spans
+                    end
+                end
+                columns[ci] = {
+                    side = column.side,
+                    lines = table.concat(column.lines, "\0"),
+                    map = table.concat(records, "\n"),
+                    spans = spans,
+                    folds = column.folds,
+                }
+            end
+            return columns
+        end)
+        return vim.mpack.encode({ ok = ok, result = result })
+    end, function(encoded)
+        vim.schedule(function()
+            local decoded = vim.mpack.decode(encoded)
+            if not decoded.ok then
+                return callback(nil, tostring(decoded.result))
+            end
+            local result = { columns = {} }
+            local ci, line_offset, map_offset, index = 1, 1, 1, 1
+            local map, lines = LineMap.new(), {}
+            local kinds = { c = "context", o = "old", n = "new", m = "meta", f = "filler" }
+            local function build_batch()
+                local started = (vim.uv or vim.loop).hrtime()
+                while ci <= #decoded.result do
+                    local raw = decoded.result[ci]
+                    local line_end = raw.lines:find("\0", line_offset, true)
+                    lines[index] = line_end and raw.lines:sub(line_offset, line_end - 1)
+                        or raw.lines:sub(line_offset)
+                    line_offset = line_end and line_end + 1 or #raw.lines + 1
+                    local map_end = raw.map:find("\n", map_offset, true)
+                    local record = raw.map:sub(map_offset, map_end and map_end - 1 or -1)
+                    map_offset = map_end and map_end + 1 or #raw.map + 1
+                    local kind, old, new, hunk = record:match("^(%a),(%d+),(%d+),(%d+)$")
+                    map:push({
+                        kind = kinds[kind],
+                        old = tonumber(old) ~= 0 and tonumber(old) or nil,
+                        new = tonumber(new) ~= 0 and tonumber(new) or nil,
+                        hunk = tonumber(hunk) ~= 0 and tonumber(hunk) or nil,
+                        spans = raw.spans[index],
+                    })
+                    index = index + 1
+                    if map_offset > #raw.map then
+                        result.columns[ci] =
+                            { side = raw.side, lines = lines, map = map, folds = raw.folds }
+                        ci, line_offset, map_offset, index = ci + 1, 1, 1, 1
+                        map, lines = LineMap.new(), {}
+                    end
+                    if ((vim.uv or vim.loop).hrtime() - started) / 1e6 >= 4 then
+                        return vim.defer_fn(build_batch, 1)
+                    end
+                end
+                result.rows = #(result.columns[1] and result.columns[1].lines or {})
+                callback(result)
+            end
+            build_batch()
+        end)
+    end)
+    work:queue(payload, worker_package_path)
+    return work
+end
+
+return M
