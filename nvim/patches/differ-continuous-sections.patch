@@ -114,16 +110,264 @@ function M.apply(bufnr, column, model)
             project.project(captures_for(model.new_text, lang), column.map.from_new)
         )
     end
+    -- Unified context projects both sources onto the same rows. Keep the last
+    -- identical mark, preserving precedence while avoiding duplicate extmarks.
+    local seen, unique = {}, {}
+    for i = #marks, 1, -1 do
+        local mark = marks[i]
+        local key = table.concat({ mark.row, mark.col_start, mark.col_end, mark.hl }, ":")
+        if not seen[key] then
+            seen[key] = true
+            unique[#unique + 1] = mark
+        end
+    end
+    for i = 1, math.floor(#unique / 2) do
+        unique[i], unique[#unique - i + 1] = unique[#unique - i + 1], unique[i]
+    end
+    for index, mark in ipairs(unique) do
+        mark.order = index
+    end
+    table.sort(unique, function(left, right)
+        return left.row == right.row and left.order < right.order or left.row < right.row
+    end)
+    return unique
+end
+
+---@class differ.SyntaxLayer
+---@field bufnr integer
