# Mods for the Herdr app, pinned like the herdr CLI in mise/config.toml.
#
# The installer downloads the release's prebuilt bundle, checks it against its
# SHA-256 and installs its mods into the running app, so run these with the app
# open. It adds its keys to keys.json only where free; the mods themselves stay
# in ~/.config/herdr-app/mods, outside this repository. Re-running `install`
# reinstalls the pinned version; bump it here to upgrade.

gitview_version := "v0.6.0"
# teknologist/herdr-space-ports has no releases; pin a commit.
space_ports_commit := "b4c4e00d3efd48b9d070896d598421177818641a"
# cybertron288/herdr-mods: only its filetree; no releases either.
filetree_commit := "34e7c3348e954fd0a1147b846898db8c3e37e526"
# nozikov/herdr-usage-limits: no releases either.
usage_limits_commit := "aee21fbdd737c91921e90b4a84cd5abfdd4caeaf"
app_home := env("HERDR_APP_HOME", env("HOME") / ".config/herdr-app")

# Install or upgrade the pinned mods into the running app; gitview first, as it makes main-copy.
install: && space-ports app-sidebar filetree usage-limits
    curl -fsSL https://raw.githubusercontent.com/ChmaraX/herdr-gitview/{{gitview_version}}/install.sh | sh -s -- --app --version {{gitview_version}}

# Copy Space Ports (Herdr's spaces list, with worktrees and branches, plus each space's
# listening ports; a VM port is forwarded over ssh when clicked) into the app, and show
# it in place of the spaces list in main-copy, the layout the installers own.
space-ports:
    #!/usr/bin/env bash
    set -euo pipefail
    src="$(mktemp -d)"
    trap 'rm -rf "$src"' EXIT
    git -C "$src" init -q
    git -C "$src" fetch -q --depth 1 https://github.com/teknologist/herdr-space-ports.git "{{space_ports_commit}}"
    git -C "$src" checkout -q FETCH_HEAD
    rsync -a --delete "$src/mods/spaces-ports/" "{{app_home}}/mods/spaces-ports/"
    herdr-app check "{{app_home}}/mods/spaces-ports"
    layout="{{app_home}}/layouts/main-copy.json"
    [ -f "$layout" ] || { echo "space-ports: no main-copy layout yet; install gitview first, then rerun"; exit 0; }
    jq '(.. | objects | select(.id? == "spaces") | .content.mod) = "spaces-ports"' "$layout" > "$layout.tmp"
    mv "$layout.tmp" "$layout"
    echo "space-ports: shown in place of the spaces list in main-copy"

# Add the app sidebar's block, hidden, between main-copy's panes and its panel,
# and the floating copy of the mod that takes Cmd+E and follows tab switches.
app-sidebar:
    #!/usr/bin/env bash
    set -euo pipefail
    layout="{{app_home}}/layouts/main-copy.json"
    [ -f "$layout" ] || { echo "app-sidebar: no main-copy layout yet; install gitview first, then rerun"; exit 0; }
    jq '
      def block: {id: "app-sidebar", type: "block", hidden: true, size: {weight: 0.6667}, min: 320,
                  radius: 6, border: {width: 1, color: "border"}, content: {mod: "app-sidebar"}};
      def sync: {id: "app-sidebar-sync", content: {mod: "app-sidebar", props: {role: "sync"}}, edge: "bottom", align: "start"};
      (if any(.. | objects; .id? == "app-sidebar") then . else
        walk(if type == "object" and .id? == "work-body"
             then .children |= (map(select(.id == "main")) + [block] + map(select(.id != "main")))
             else . end) end)
      | (if any(.floating[]?; .id == "app-sidebar-sync") then . else .floating = ((.floating // []) + [sync]) end)
    ' "$layout" > "$layout.tmp"
    mv "$layout.tmp" "$layout"
    echo "app-sidebar: block and sync in main-copy"

# Copy filetree (git state per file, search, preview) and the file-icons it draws from
# into the app, and show it in the panel's Files tab of main-copy in place of Herdr's tree.
filetree:
    #!/usr/bin/env bash
    set -euo pipefail
    src="$(mktemp -d)"
    trap 'rm -rf "$src"' EXIT
    git -C "$src" init -q
    git -C "$src" fetch -q --depth 1 https://github.com/cybertron288/herdr-mods.git "{{filetree_commit}}"
    git -C "$src" checkout -q FETCH_HEAD
    for mod in filetree file-icons; do
        rsync -a --delete "$src/filetree/mods/$mod/" "{{app_home}}/mods/$mod/"
        herdr-app check "{{app_home}}/mods/$mod"
    done
    # filetree previews files in a VM space instead of running `open`, and runs `open` in the
    # file's folder, which is on the VM; let it run there too, from the app's own folder.
    main="{{app_home}}/mods/filetree/main.js"
    grep -qF 'if (how === "preview" || this.on) {' "$main" && grep -qF '{ cwd: dir });' "$main" \
        || { echo "filetree: its open code changed; update the patch in herdr-app/justfile" >&2; exit 1; }
    sed -i.bak -e 's/if (how === "preview" || this\.on) {/if (how === "preview") {/' \
        -e 's/{ cwd: dir });/this.on ? {} : { cwd: dir });/' "$main"
    rm "$main.bak"
    herdr-app check "{{app_home}}/mods/filetree"
    # Enter opens files in the tab's sidebar nvim; the app's PATH has no herdr-app, so its full path.
    config="{{app_home}}/mods/filetree/config.json"
    jq --arg app "$(realpath "$(command -v herdr-app)")" '.open = "\"\($app)\" do app-sidebar.open:{path}"' "$config" > "$config.tmp"
    mv "$config.tmp" "$config"
    layout="{{app_home}}/layouts/main-copy.json"
    [ -f "$layout" ] || { echo "filetree: no main-copy layout yet; install gitview first, then rerun"; exit 0; }
    jq '(.. | objects | select(.id? == "files") | .content.mod) = "filetree"' "$layout" > "$layout.tmp"
    mv "$layout.tmp" "$layout"
    echo "filetree: shown in the panel's Files tab in main-copy"

# Copy usage-limits (Claude Code and Codex limits, OpenCode's tokens) into the app, and
# split main-copy's status bar into Herdr's status, the limits and an empty third.
usage-limits:
    #!/usr/bin/env bash
    set -euo pipefail
    src="$(mktemp -d)"
    trap 'rm -rf "$src"' EXIT
    git -C "$src" init -q
    git -C "$src" fetch -q --depth 1 https://github.com/nozikov/herdr-usage-limits.git "{{usage_limits_commit}}"
    git -C "$src" checkout -q FETCH_HEAD
    # Copied: Herdr draws a linked copy of this mod blank.
    rsync -a --delete --exclude test "$src/mods/usage-limits/" "{{app_home}}/mods/usage-limits/"
    herdr-app check "{{app_home}}/mods/usage-limits"
    layout="{{app_home}}/layouts/main-copy.json"
    [ -f "$layout" ] || { echo "usage-limits: no main-copy layout yet; install gitview first, then rerun"; exit 0; }
    # Thirds: Herdr's status, the limits (drawn against their block's right edge), and the
    # spacer mod, so the limits end two thirds across rather than at the window's edge.
    jq '
      def row: {id: "status-row", type: "row", size: {px: 28}, resizable: false, children: [
        {id: "status", type: "block", size: {weight: 1}, content: {mod: "workspace-status"}},
        {id: "usage-limits", type: "block", size: {weight: 1}, min: 130, content: {mod: "usage-limits"}},
        {id: "status-spacer", type: "block", size: {weight: 1}, content: {mod: "spacer"}}]};
      walk(if type == "object" and (.id? == "status-row" or (.id? == "status" and .content.mod? == "workspace-status")) then row else . end)
    ' "$layout" > "$layout.tmp"
    mv "$layout.tmp" "$layout"
    echo "usage-limits: in main-copy's status bar"

# Remove it; the stock Changes panel comes back.
uninstall:
    curl -fsSL https://raw.githubusercontent.com/ChmaraX/herdr-gitview/{{gitview_version}}/install.sh | sh -s -- --app --uninstall
